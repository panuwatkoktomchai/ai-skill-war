# Formatting rules read by ktlint (the Kotlin equivalent of Prettier) and by editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 100
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,md,json,yml,yaml}]
indent_size = 2
